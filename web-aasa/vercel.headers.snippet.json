{
  "crons": [
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/author-reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/childrens-day",
      "schedule": "0 9 1 6 *"
    },
    {
      "path": "/api/cron/fathers-day",
      "schedule": "0 9 21 6 *"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
